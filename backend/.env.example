# =============================================================================
# Configuration AgroSense - Copiez ce fichier en .env et adaptez les valeurs
# =============================================================================

# -----------------------------------------------------------------------------
# Environnement Flask
# -----------------------------------------------------------------------------
FLASK_ENV=development  # development | production | testing
FLASK_DEBUG=False     # Ne JAMAIS mettre True en production

# -----------------------------------------------------------------------------
# Clés secrètes (générez-en de nouvelles avec: python -c "import secrets; print(secrets.token_hex(32))")
# -----------------------------------------------------------------------------
SECRET_KEY=your_64_character_hex_secret_key_here
JWT_SECRET_KEY=your_64_character_hex_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_MIN=1440  # 24 heures

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://agrosense_user:agrosense_pass@localhost:5432/agrosense_db

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Liste des origines autorisées, séparées par des virgules
# Exemple: http://localhost:3000,http://127.0.0.1:3000,https://votre-domaine.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Sécurité
# -----------------------------------------------------------------------------
# Timeout des requêtes (en secondes)
REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# Configuration optionnelle
# -----------------------------------------------------------------------------
# Activer pour voir les requêtes SQL dans la console (développement uniquement)
# SQLALCHEMY_ECHO=False

# Activer le mode debug Flask (développement uniquement)
# FLASK_DEBUG=True
